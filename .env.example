# General Application Settings (FastAPI)
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/nehal_teacher_db

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
LLM_API_KEY=your_llm_api_key_here

# Speech Services (STT / TTS)
STT_API_KEY=your_stt_api_key_here
TTS_API_KEY=your_tts_api_key_here

# Authentication & Firebase Secrets
FIREBASE_AUTH_KEY=your_firebase_auth_key_here
FIREBASE_PROJECT_ID=nehal-teacher-ai
JWT_SECRET_KEY=your_jwt_secret_key_here

# Feature Flags
ENABLE_FEATURE_X=false
ENABLE_FEATURE_Y=false
